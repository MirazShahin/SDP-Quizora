@using Microsoft.AspNetCore.Components.Authorization
@using Quizora.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            Quizora
            <span class="brand-sub">by HaMiko</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column nav-boxes">
        <div class="nav-item">
            <NavLink class="nav-link nav-box" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                <span>Home</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @if (isCompany)
                {
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="company/dashboard">
                            <span class="bi bi-speedometer2" aria-hidden="true"></span>
                            <span>Dashboard</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="contests">
                            <span class="bi bi-trophy" aria-hidden="true"></span>
                            <span>Contests</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="company/results">
                            <span class="bi bi-bar-chart-line" aria-hidden="true"></span>
                            <span>Results</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="company/cvs">
                            <span class="bi bi-file-earmark-pdf" aria-hidden="true"></span>
                            <span>Candidate CVs</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="company/coding-problems">
                            <span class="bi bi-code-slash" aria-hidden="true"></span>
                            <span>Problem Bank</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="company/contests">
                            <span class="bi bi-trophy-fill" aria-hidden="true"></span>
                            <span>My Contests</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="company/contests/create">
                            <span class="bi bi-plus-circle" aria-hidden="true"></span>
                            <span>Create Contest</span>
                        </NavLink>
                    </div>

                }
                else if (isCandidate)
                {
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="candidate/dashboard">
                            <span class="bi bi-person-badge" aria-hidden="true"></span>
                            <span>My Tests</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="contests">
                            <span class="bi bi-trophy" aria-hidden="true"></span>
                            <span>Contests</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="candidate/assistant">
                            <span class="bi bi-robot" aria-hidden="true"></span>
                            <span>AI Assistant</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="candidate/coding">
                            <span class="bi bi-code-slash" aria-hidden="true"></span>
                            <span>Problem Solving</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="candidate/weak-topics">
                            <span class="bi bi-graph-down" aria-hidden="true"></span>
                            <span>Weak Topics</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="practice">
                            <span class="bi bi-pencil-square" aria-hidden="true"></span>
                            <span>Practice</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="mock-tests">
                            <span class="bi bi-stopwatch" aria-hidden="true"></span>
                            <span>Mock Tests</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link nav-box" href="candidate/cv">
                            <span class="bi bi-file-earmark-person" aria-hidden="true"></span>
                            <span>My CV</span>
                        </NavLink>
                    </div>
                }

                <div class="nav-item">
                    <NavLink class="nav-link nav-box" href="profile">
                        <span class="bi bi-person-circle" aria-hidden="true"></span>
                        <span>Profile</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <button type="button" class="nav-link nav-box btn-logout" @onclick="Logout">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                        <span>Logout</span>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link nav-box" href="login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span>
                        <span>Login</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link nav-box" href="register">
                        <span class="bi bi-person-plus" aria-hidden="true"></span>
                        <span>Register</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<style>
    .navbar-brand {
        line-height: 1.15;
    }

    .brand-sub {
        display: block;
        font-size: 0.65rem;
        font-weight: 500;
        opacity: 0.75;
        letter-spacing: 0.04em;
        margin-top: 1px;
    }

    .nav-boxes {
        padding: 0.75rem 0.65rem 1.25rem;
        gap: 0;
    }

        .nav-boxes .nav-item {
            margin-bottom: 0.4rem;
            padding: 0 !important;
        }

        .nav-boxes .nav-box {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            width: 100%;
            padding: 0.75rem 0.95rem !important;
            margin: 0;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.92) !important;
            font-size: 0.95rem;
            font-weight: 500;
            line-height: 1.25;
            text-decoration: none !important;
            transition: background .15s ease, border-color .15s ease, transform .15s ease, box-shadow .15s ease;
        }

            .nav-boxes .nav-box:hover {
                background: rgba(255, 255, 255, 0.1);
                border-color: rgba(255, 255, 255, 0.22);
                transform: translateX(2px);
                color: #fff !important;
            }

            .nav-boxes .nav-box.active {
                background: rgba(20, 184, 166, 0.4);
                border-color: rgba(94, 234, 212, 0.65);
                color: #fff !important;
                font-weight: 600;
                box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
            }

            .nav-boxes .nav-box .bi {
                font-size: 1.15rem;
                width: 1.35rem;
                text-align: center;
                opacity: 0.95;
                flex-shrink: 0;
            }

        .nav-boxes .btn-logout {
            background: rgba(248, 113, 113, 0.12);
            border-color: rgba(248, 113, 113, 0.35);
            cursor: pointer;
            text-align: left;
        }

            .nav-boxes .btn-logout:hover {
                background: rgba(248, 113, 113, 0.22);
                border-color: rgba(248, 113, 113, 0.5);
            }

    /* Light theme */
    :root[data-theme="light"] .nav-boxes .nav-box,
    html[data-theme="light"] .nav-boxes .nav-box {
        background: rgba(15, 23, 42, 0.04);
        border-color: rgba(15, 23, 42, 0.12);
        color: #1e293b !important;
    }

        :root[data-theme="light"] .nav-boxes .nav-box:hover,
        html[data-theme="light"] .nav-boxes .nav-box:hover {
            background: rgba(15, 23, 42, 0.08);
            color: #0f172a !important;
        }

        :root[data-theme="light"] .nav-boxes .nav-box.active,
        html[data-theme="light"] .nav-boxes .nav-box.active {
            background: #ccfbf1;
            border-color: #5eead4;
            color: #115e59 !important;
            box-shadow: 0 2px 10px rgba(99, 102, 241, 0.15);
        }
</style>

@code {
    private bool isCompany = false;
    private bool isCandidate = false;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isCompany = user.IsInRole("Company");
        isCandidate = user.IsInRole("Candidate");
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}