@page "/about"
@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h2 class="fw-bold mb-2">About Quizora</h2>
                    <p class="text-muted mb-4">
                        Interview preparation & assessment platform
                    </p>

                    <h5 class="fw-semibold">What is Quizora?</h5>
                    <p>
                        Quizora is a hiring and interview preparation platform where companies can
                        create assessments and invite candidates, while candidates can practice,
                        take mock tests, and prepare for interviews.
                    </p>

                    <h5 class="fw-semibold mt-4">For Companies</h5>
                    <ul>
                        <li>Create official MCQ tests</li>
                        <li>Invite candidates by email</li>
                        <li>Track completion and review results</li>
                        <li>One-shot timed assessments</li>
                    </ul>

                    <h5 class="fw-semibold mt-4">For Candidates</h5>
                    <ul>
                        <li>Take assigned company tests</li>
                        <li>Practice topic-wise questions</li>
                        <li>Timed mock tests</li>
                        <li>Interview preparation materials</li>
                    </ul>

                    <h5 class="fw-semibold mt-4">Built with</h5>
                    <p class="mb-0">
                        ASP.NET Core, Blazor, PostgreSQL, Clean Architecture
                    </p>

                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">Back to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>