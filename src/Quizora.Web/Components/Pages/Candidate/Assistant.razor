@page "/candidate/assistant"
@rendermode InteractiveServer
@inject HttpClient Http

<div class="assistant-page">
    <div class="assistant-header">
        <div>
            <h2 class="fw-bold mb-1">AI Assistant</h2>
            <p class="text-muted small mb-0">
                Ask anything — programming, CS fundamentals, interview prep.
            </p>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Clear" disabled="@busy">
            Clear chat
        </button>
    </div>

    <div class="chat-window" @ref="chatBox">
        @if (messages.Count == 0)
        {
            <div class="chat-empty">
                <div class="fs-2 mb-2">💬</div>
                <div class="fw-semibold">Start a conversation</div>
                <div class="small text-muted mt-1">
                    e.g. “Explain polymorphism with C++ example” · “What is indexing in DBMS?”
                </div>
            </div>
        }
        else
        {
            @foreach (var m in messages)
            {
                <div class="bubble-row @(m.Role == "user" ? "me" : "bot")">
                    <div class="bubble @(m.Role == "user" ? "bubble-user" : "bubble-bot")">
                        <div class="bubble-role">@(m.Role == "user" ? "You" : "Assistant")</div>
                        <div class="bubble-text">@m.Content</div>
                    </div>
                </div>
            }
        }

        @if (busy)
        {
            <div class="bubble-row bot">
                <div class="bubble bubble-bot typing">Assistant is typing…</div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger py-2 small mt-2 mb-2">@error</div>
    }

    <div class="composer">
        <textarea class="form-control composer-input"
                  rows="2"
                  placeholder="Type your question…"
                  @bind="input"
                  @bind:event="oninput"
                  @onkeydown="OnKey"
                  disabled="@busy"></textarea>
        <button type="button" class="btn btn-primary send-btn" disabled="@(busy || string.IsNullOrWhiteSpace(input))" @onclick="Send">
            Send
        </button>
    </div>
</div>

<style>
    .assistant-page {
        max-width: 820px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 120px);
        min-height: 480px;
    }

    .assistant-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.85rem;
    }

    .chat-window {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        border-radius: 14px;
        border: 1px solid rgba(127, 127, 127, 0.25);
        background: rgba(0, 0, 0, 0.15);
    }

    .chat-empty {
        height: 100%;
        min-height: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        opacity: 0.9;
    }

    .bubble-row {
        display: flex;
        margin-bottom: 0.75rem;
    }

        .bubble-row.me {
            justify-content: flex-end;
        }

        .bubble-row.bot {
            justify-content: flex-start;
        }

    .bubble {
        max-width: min(85%, 560px);
        padding: 0.7rem 0.95rem;
        border-radius: 14px;
        line-height: 1.5;
        font-size: 0.92rem;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .bubble-user {
        background: #1f6feb;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .bubble-bot {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom-left-radius: 4px;
    }

    .bubble-role {
        font-size: 0.68rem;
        font-weight: 600;
        opacity: 0.75;
        margin-bottom: 0.2rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .typing {
        opacity: 0.8;
        font-style: italic;
    }

    .composer {
        display: flex;
        gap: 0.6rem;
        margin-top: 0.75rem;
        align-items: flex-end;
    }

    .composer-input {
        resize: none;
        border-radius: 12px;
    }

    .send-btn {
        border-radius: 12px;
        padding: 0.55rem 1.15rem;
        font-weight: 600;
        white-space: nowrap;
    }
</style>

@code {
    private readonly List<Msg> messages = new();
    private string input = "";
    private string? error;
    private bool busy;
    private ElementReference chatBox;

    private async Task Send()
    {
        var text = input?.Trim();
        if (string.IsNullOrWhiteSpace(text) || busy) return;

        error = null;
        messages.Add(new Msg("user", text));
        input = "";
        busy = true;
        await ScrollBottom();

        try
        {
            var history = messages
                .Take(messages.Count - 1) // current user msg আলাদা যাবে
                .Select(m => new { role = m.Role, content = m.Content })
                .ToList();

            var resp = await Http.PostAsJsonAsync("api/ai/assistant", new
            {
                message = text,
                history
            });

            var raw = await resp.Content.ReadAsStringAsync();
            var api = System.Text.Json.JsonSerializer.Deserialize<ApiResult<string>>(raw,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (api?.IsSuccess == true && !string.IsNullOrWhiteSpace(api.Data))
                messages.Add(new Msg("assistant", api.Data!));
            else
                error = api?.Message ?? $"Request failed ({(int)resp.StatusCode})";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
            await ScrollBottom();
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Send();
        }
    }

    private void Clear()
    {
        messages.Clear();
        error = null;
        input = "";
    }

    private async Task ScrollBottom()
    {
        try
        {
            await Task.Delay(30);
            // optional: JS interop — without JS, user can scroll
            StateHasChanged();
        }
        catch { }
    }

    private record Msg(string Role, string Content);

    private class ApiResult<T>
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public T? Data { get; set; }
    }
}