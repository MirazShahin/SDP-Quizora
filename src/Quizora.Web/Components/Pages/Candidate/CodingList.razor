@page "/candidate/coding"
@rendermode InteractiveServer
@inject HttpClient Http

<div class="container py-4">
    <h3 class="fw-bold mb-1">Coding Practice</h3>
    <p class="text-muted small mb-4">Solve problems · C / C++</p>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (loading)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (items.Count == 0)
    {
        <div class="alert alert-info">No problems yet. Admin Problem Bank-এ যোগ করুক।</div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var p in items)
            {
                <a href="/candidate/coding/@p.Id" class="list-group-item list-group-item-action d-flex justify-content-between">
                    <div>
                        <div class="fw-semibold">@p.Title</div>
                        <div class="small text-muted">@p.TimeLimitMs ms</div>
                    </div>
                    <span class="badge @Badge(p.Status)">@p.Status</span>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Item> items = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var resp = await Http.GetAsync("api/coding/problems");
            var raw = await resp.Content.ReadAsStringAsync();
            var api = System.Text.Json.JsonSerializer.Deserialize<ApiResult<List<Item>>>(raw,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (api?.IsSuccess == true) items = api.Data ?? new();
            else error = api?.Message ?? "Failed";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; StateHasChanged(); }
    }

    private static string Badge(string s) => s == "Accepted" ? "bg-success" :
        s is "WrongAnswer" or "RuntimeError" ? "bg-danger" :
        s is "CompilationError" or "TimeLimitExceeded" ? "bg-warning text-dark" : "bg-secondary";

    public class Item
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public int TimeLimitMs { get; set; }
        public string Status { get; set; } = "—";
    }
    public class ApiResult<T>
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public T? Data { get; set; }
    }
}