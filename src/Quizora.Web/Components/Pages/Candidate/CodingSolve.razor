@page "/candidate/coding/{Id:guid}"
@rendermode InteractiveServer
@inject HttpClient Http

<div class="container-fluid py-3">
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (loading)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (problem != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <a href="/candidate/coding" class="small">← All problems</a>
                <h4 class="fw-bold mb-0">@problem.Title</h4>
                <div class="small text-muted">Time limit: @problem.TimeLimitMs ms</div>
            </div>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width:auto" @bind="language">
                    <option value="cpp">C++</option>
                    <option value="c">C</option>
                </select>
                <button class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="Run">Run</button>
                <button class="btn btn-success btn-sm" disabled="@busy" @onclick="Submit">Submit</button>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6>Statement</h6>
                        <pre class="small" style="white-space:pre-wrap;font-family:inherit">@problem.Statement</pre>
                        @foreach (var s in problem.Samples)
                        {
                            <div class="border rounded p-2 mb-2 small">
                                <div class="text-muted">Input</div>
                                <pre class="font-monospace mb-1">@s.Input</pre>
                                <div class="text-muted">Output</div>
                                <pre class="font-monospace mb-0">@s.ExpectedOutput</pre>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <textarea class="form-control font-monospace mb-2" rows="18" @bind="code"></textarea>
                @if (!string.IsNullOrEmpty(verdict))
                {
                    <div class="alert @(verdict == "Accepted" ? "alert-success" : "alert-warning")">
                        <strong>@verdict</strong> @info
                    </div>
                }
                @if (!string.IsNullOrEmpty(output))
                {
                    <pre class="small font-monospace border rounded p-2">@output</pre>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private Prob? problem;
    private bool loading = true, busy;
    private string? error, verdict, output, info;
    private string language = "cpp";
    private string code = "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <map>\n#include <set>\n#include <queue>\n#include <stack>\n#include <cmath>\nusing namespace std;\nint main(){\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n  \n  return 0;\n}\n";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var resp = await Http.GetAsync($"api/coding/problems/{Id}");
            var raw = await resp.Content.ReadAsStringAsync();
            var api = D<ApiResult<Prob>>(raw);
            if (api?.IsSuccess == true) problem = api.Data;
            else error = api?.Message ?? "Failed";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; StateHasChanged(); }
    }

    private async Task Run()
    {
        if (problem?.Samples.Count is not > 0) { error = "No sample"; return; }
        busy = true; error = null; verdict = null; output = null;
        try
        {
            var s = problem.Samples[0];
            var resp = await Http.PostAsJsonAsync("api/Code/run", new
            {
                Language = language,
                SourceCode = code,
                Stdin = s.Input,
                ExpectedOutput = s.ExpectedOutput
            });
            var raw = await resp.Content.ReadAsStringAsync();
            var api = D<ApiResult<RunDto>>(raw);
            if (api?.IsSuccess == true && api.Data != null)
            {
                verdict = api.Data.Status;
                output = $"stdout:\n{api.Data.Stdout}\n\nstderr:\n{api.Data.Stderr}\n\n{api.Data.CompileOutput}";
            }
            else error = api?.Message ?? "Run failed";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Submit()
    {
        busy = true; error = null; verdict = null; output = null; info = null;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/coding/problems/{Id}/submit",
                new { Language = language, SourceCode = code });
            var raw = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(raw)) { error = $"HTTP {(int)resp.StatusCode}"; return; }
            var api = D<ApiResult<SubDto>>(raw);
            if (api?.IsSuccess == true && api.Data != null)
            {
                verdict = api.Data.Verdict;
                info = $"{api.Data.PassedCount}/{api.Data.TotalCount} tests";
                if (api.Data.Cases != null)
                    output = string.Join("\n", api.Data.Cases.Select(c =>
                        $"#{c.Index} {(c.IsSample ? "sample" : "hidden")}: {c.Status}"));
            }
            else error = api?.Message ?? "Submit failed";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private static T? D<T>(string? raw) =>
        string.IsNullOrWhiteSpace(raw) ? default :
        System.Text.Json.JsonSerializer.Deserialize<T>(raw,
            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

    public class Prob
    {
        public string Title { get; set; } = "";
        public string Statement { get; set; } = "";
        public int TimeLimitMs { get; set; }
        public List<Sample> Samples { get; set; } = new();
    }
    public class Sample { public string Input { get; set; } = ""; public string ExpectedOutput { get; set; } = ""; }
    public class RunDto { public string Status { get; set; } = ""; public string Stdout { get; set; } = ""; public string Stderr { get; set; } = ""; public string CompileOutput { get; set; } = ""; }
    public class SubDto
    {
        public string Verdict { get; set; } = "";
        public int PassedCount { get; set; }
        public int TotalCount { get; set; }
        public List<CaseDto>? Cases { get; set; }
    }
    public class CaseDto { public int Index { get; set; } public bool IsSample { get; set; } public string Status { get; set; } = ""; }
    public class ApiResult<T> { public bool IsSuccess { get; set; } public string? Message { get; set; } public T? Data { get; set; } }
}