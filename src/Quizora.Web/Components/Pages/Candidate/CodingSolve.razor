</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private Prob? problem;
    private bool loading = true, busy;
    private string? error, verdict, output, info;
    private string language = "cpp";
    private string mode = "";
    private string code =
@"#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
#include <map>
#include <set>
#include <queue>
#include <stack>
#include <cmath>
using namespace std;
int main(){
  ios::sync_with_stdio(false);
  cin.tie(nullptr);

  return 0;
}
";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var resp = await Http.GetAsync($"api/coding/problems/{Id}");
            var raw = await resp.Content.ReadAsStringAsync();
            var api = D<ApiResult<Prob>>(raw);
            if (api?.IsSuccess == true)
                problem = api.Data;
            else
                error = api?.Message ?? "Failed to load problem";
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task Run()
    {
        if (problem?.Samples == null || problem.Samples.Count == 0)
        {
            error = "No sample test case";
            return;
        }

        busy = true;
        mode = "run";
        error = null;
        verdict = null;
        output = null;
        info = null;

        try
        {
            var s = problem.Samples[0];
            var resp = await Http.PostAsJsonAsync("api/Code/run", new
            {
                Language = language,
                SourceCode = code,
                Stdin = s.Input,
                ExpectedOutput = s.ExpectedOutput
            });
            var raw = await resp.Content.ReadAsStringAsync();
            var api = D<ApiResult<RunDto>>(raw);

            if (api?.IsSuccess == true && api.Data != null)
            {
                var r = api.Data;
                verdict = r.Status;
                info = "sample #1";

                var parts = new List<string>();
                if (!string.IsNullOrWhiteSpace(r.CompileOutput))
                    parts.Add("compile:\n" + r.CompileOutput.Trim());
                if (!string.IsNullOrWhiteSpace(r.Stdout))
                    parts.Add("stdout:\n" + r.Stdout.Trim());
                if (!string.IsNullOrWhiteSpace(r.Stderr))
                    parts.Add("stderr:\n" + r.Stderr.Trim());
                if (parts.Count == 0)
                    parts.Add("(no output)");
                output = string.Join("\n\n", parts);
            }
            else
            {
                error = api?.Message ?? "Run failed";
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            busy = false;
            mode = "";
        }
    }

    private async Task Submit()
    {
        busy = true;
        mode = "submit";
        error = null;
        verdict = null;
        output = null;
        info = null;

        try
        {
            var resp = await Http.PostAsJsonAsync($"api/coding/problems/{Id}/submit",
                new { Language = language, SourceCode = code });
            var raw = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(raw))
            {
                error = $"HTTP {(int)resp.StatusCode}";
                return;
            }

            var api = D<ApiResult<SubDto>>(raw);
            if (api?.IsSuccess == true && api.Data != null)
            {
                verdict = api.Data.Verdict;
                info = $"{api.Data.PassedCount}/{api.Data.TotalCount} tests";
                if (api.Data.Cases != null)
                {
                    output = string.Join("\n", api.Data.Cases.Select(c =>
                        $"#{c.Index} {(c.IsSample ? "sample" : "hidden")}: {c.Status}"));
                }
            }
            else
            {
                error = api?.Message ?? "Submit failed";
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            busy = false;
            mode = "";
        }
    }

    private static string VerdictClass(string? v)
    {
        v = (v ?? "").ToLowerInvariant();
        if (v.Contains("accept")) return "ac";
        if (v.Contains("wrong")) return "wa";
        if (v.Contains("compilation") || v.Contains("compile")) return "ce";
        if (v.Contains("time")) return "tle";
        if (v.Contains("runtime")) return "re";
        return "other";
    }

    private static T? D<T>(string? raw) =>
        string.IsNullOrWhiteSpace(raw) ? default :
        System.Text.Json.JsonSerializer.Deserialize<T>(raw,
            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

    public class Prob
    {
        public string Title { get; set; } = "";
        public string Statement { get; set; } = "";
        public int TimeLimitMs { get; set; }
        public List<Sample> Samples { get; set; } = new();
    }

    public class Sample
    {
        public string Input { get; set; } = "";
        public string ExpectedOutput { get; set; } = "";
    }

    public class RunDto
    {
        public string Status { get; set; } = "";
        public string Stdout { get; set; } = "";
        public string Stderr { get; set; } = "";
        public string CompileOutput { get; set; } = "";
    }

    public class SubDto
    {
        public string Verdict { get; set; } = "";
        public int PassedCount { get; set; }
        public int TotalCount { get; set; }
        public List<CaseDto>? Cases { get; set; }
    }

    public class CaseDto
    {
        public int Index { get; set; }
        public bool IsSample { get; set; }
        public string Status { get; set; } = "";
    }

    public class ApiResult<T>
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public T? Data { get; set; }
    }
}