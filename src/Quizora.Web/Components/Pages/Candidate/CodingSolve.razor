@page "/candidate/coding/{Id:guid}"
@rendermode InteractiveServer
@inject HttpClient Http

<div class="ps-page">
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger mb-3">@error</div>
    }

    @if (loading)
    {
        <div class="text-center py-5 text-muted">
            <div class="spinner-border spinner-border-sm"></div>
            <span class="ms-2">Loading problem...</span>
        </div>
    }
    else if (problem != null)
    {
        <div class="ps-topbar">
            <div>
                <a href="/candidate/coding" class="ps-back">← All problems</a>
                <h1 class="ps-title">@problem.Title</h1>
                <div class="ps-meta">Time limit: @problem.TimeLimitMs ms · Problem Solving</div>
            </div>
            <div class="ps-actions">
                <select class="ps-lang" @bind="language">
                    <option value="cpp">C++</option>
                    <option value="c">C</option>
                </select>
                <button type="button" class="btn-run" disabled="@busy" @onclick="Run">
                    @(busy && mode == "run" ? "Running..." : "Run")
                </button>
                <button type="button" class="btn-submit" disabled="@busy" @onclick="Submit">
                    @(busy && mode == "submit" ? "Judging..." : "Submit")
                </button>
            </div>
        </div>

        <div class="ps-grid">
            @* Statement *@
            <div class="ps-panel">
                <div class="ps-panel-head">Statement</div>
                <div class="ps-statement">
                    <div class="ps-body">@problem.Statement</div>

                    @if (problem.Samples?.Count > 0)
                    {
                        <div class="ps-section-label">Samples</div>
                        @foreach (var s in problem.Samples)
                        {
                            <div class="ps-sample">
                                <div class="ps-sample-label">Input</div>
                                <pre>@(string.IsNullOrEmpty(s.Input) ? "(empty)" : s.Input)</pre>
                                <div class="ps-sample-label">Output</div>
                                <pre>@(string.IsNullOrEmpty(s.ExpectedOutput) ? "(empty)" : s.ExpectedOutput)</pre>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Editor *@
            <div class="ps-panel">
                <div class="ps-panel-head">
                    Solution · @(language == "c" ? "C" : "C++")
                    <span class="ps-hint">Full program · no starter</span>
                </div>
                <div class="ps-editor-wrap">
                    <textarea class="ps-editor"
                              @bind="code"
                              @bind:event="oninput"
                              spellcheck="false"
                              placeholder="// Write your full C/C++ program here"></textarea>
                </div>
            </div>
        </div>

        @* Verdict *@
        @if (!string.IsNullOrEmpty(verdict))
        {
            <div class="ps-verdict @VerdictClass(verdict)">
                <span>@verdict</span>
                @if (!string.IsNullOrEmpty(info))
                {
                    <span class="ps-verdict-info">· @info</span>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(output))
        {
            <div class="ps-console">
                <strong>Output / tests</strong>
                <pre class="mb-0 mt-1">@output</pre>
            </div>
        }
    }
</div>

<style>
