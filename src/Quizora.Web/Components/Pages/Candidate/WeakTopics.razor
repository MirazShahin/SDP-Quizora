@page "/candidate/weak-topics"
@rendermode InteractiveServer
@using Quizora.Web.Services
@inject AiClient Ai

<div class="container py-4" style="max-width: 720px;">
    <h3 class="fw-bold mb-1">Weak Topics</h3>
    <p class="text-muted mb-4">
        Calculated from your real practice &amp; mock scores (own algorithm).
    </p>

    <button type="button" class="btn btn-primary mb-3" disabled="@loading" @onclick="Load">
        @(loading ? "Analyzing..." : "Analyze my performance")
    </button>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (summary != null)
    {
        <div class="row g-2 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="fs-4 fw-bold">@summary.PracticeSessions</div>
                    <div class="small text-muted">Practice</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="fs-4 fw-bold">@summary.MockSessions</div>
                    <div class="small text-muted">Mocks</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="fs-4 fw-bold">@summary.AvgAccuracy%</div>
                    <div class="small text-muted">Avg accuracy</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="fs-5 fw-bold text-truncate">@(summary.StrongestTopic ?? "—")</div>
                    <div class="small text-muted">Strongest</div>
                </div>
            </div>
        </div>

        @if (summary.WeakTopics == null || !summary.WeakTopics.Any())
        {
            <div class="alert alert-info">
                No weak topics yet. Finish a few
                <a href="/practice">Practice</a> or
                <a href="/mock-tests">Mock</a> sessions first.
            </div>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var t in summary.WeakTopics)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                            <div>
                                <div class="fw-semibold">@t.Topic</div>
                                <div class="small text-muted">
                                    @t.Score / @t.Total correct · @t.Accuracy% · @t.Source
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @SeverityBadge(t.Severity)">@t.Severity</span>
                                <a class="btn btn-sm btn-outline-primary" href="/practice">Practice</a>
                            </div>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar @SeverityBar(t.Severity)"
                                 role="progressbar"
                                 style="@($"width:{t.Accuracy.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private AiClient.PerformanceSummaryDto? summary;
    private string? error;
    private bool loading;

    private async Task Load()
    {
        loading = true;
        error = null;
        summary = null;
        try
        {
            var (data, err) = await Ai.WeakTopicsAsync();
            summary = data;
            error = err;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string SeverityBadge(string? s) => s switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning text-dark",
        _ => "bg-success"
    };

    private static string SeverityBar(string? s) => s switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning",
        _ => "bg-success"
    };
}