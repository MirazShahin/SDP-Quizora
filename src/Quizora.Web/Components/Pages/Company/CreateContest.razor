@page "/company/contests/create"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Quizora.Application.Common
@using Quizora.Application.DTOs.Contest
@using Quizora.Application.DTOs.Coding
@using Quizora.Web.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h3 class="mb-1">Create Coding Contest</h3>
                            <p class="text-muted mb-0 small">Public contest — everyone can join and solve</p>
                        </div>
                        <a href="/company/contests" class="btn btn-outline-secondary btn-sm">My Contests</a>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">@successMessage</div>
                    }

                    <EditForm Model="model" OnValidSubmit="HandleCreate">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Contest Title *</label>
                            <InputText class="form-control" @bind-Value="model.Title"
                                       placeholder="e.g. Weekly Coding Challenge #12" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="model.Description"
                                           placeholder="Rules, scoring, or any note for participants..." />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Duration (minutes) *</label>
                                <InputNumber class="form-control" @bind-Value="model.DurationInMinutes" min="15" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Start Time</label>
                                <input type="datetime-local"
                                       class="form-control"
                                       value="@FormatForInput(startLocal)"
                                       @onchange="OnStartChanged" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">End Time</label>
                                <input type="datetime-local"
                                       class="form-control"
                                       value="@FormatForInput(endLocal)"
                                       @onchange="OnEndChanged" />
                            </div>
                        </div>

                        <p class="small text-muted mb-3">
                            Times are in <strong>your</strong> local timezone
                            @(tzOffsetMinutes.HasValue ? $" (UTC{FormatOffset(tzOffsetMinutes.Value)})" : "")
                            and stored correctly regardless of where the server runs.
                        </p>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Select Problems</h5>
                            <span class="badge bg-primary">@selectedIds.Count selected</span>
                        </div>

                        @if (loadingProblems)
                        {
                            <p class="text-muted">Loading problem bank...</p>
                        }
                        else if (problems.Count == 0)
                        {
                            <div class="alert alert-warning">
                                No active coding problems found.
                                <a href="/company/coding-problems">Add problems first</a>
                            </div>
                        }
                        else
                        {
                            <div class="list-group problem-list mb-4" style="max-height: 360px; overflow-y: auto;">
                                @foreach (var p in problems)
                                {
                                    var pid = p.Id;
                                    var isSelected = selectedIds.Contains(pid);
                                    <label class="list-group-item list-group-item-action d-flex align-items-center gap-3"
                                           style="cursor: pointer;">
                                        <input type="checkbox"
                                               class="form-check-input mt-0"
                                               checked="@isSelected"
                                               @onchange="(e) => ToggleProblem(pid, e)" />
                                        <div class="flex-grow-1">
                                            <div class="problem-title">@p.Title</div>
                                            <div class="problem-meta">
                                                <span class="badge @(DifficultyBadge(p.Difficulty))">
                                                    @p.Difficulty
                                                </span>
                                                <span class="ms-2 text-muted">@p.TestCaseCount test cases · @p.TimeLimitMs ms</span>
                                            </div>
                                        </div>
                                    </label>
                                }
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4"
                                    disabled="@(isLoading || selectedIds.Count == 0)">
                                @(isLoading ? "Creating..." : "Create Contest")
                            </button>
                            <a href="/company/dashboard" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateContestDto model = new() { DurationInMinutes = 120 };
    private List<CodingProblemDto> problems = new();
    private HashSet<Guid> selectedIds = new();
    private bool isLoading;
    private bool loadingProblems = true;
    private string? errorMessage;
    private string? successMessage;

    private DateTime? startLocal;
    private DateTime? endLocal;
    private int? tzOffsetMinutes;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            tzOffsetMinutes = await JS.InvokeAsync<int>("quizoraTime.getOffsetMinutes");
            StateHasChanged();
        }
        catch
        {
            // JS interop not available during prerender
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/CodingProblems");

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "You are not authorized. Please login again."
                    : $"Failed to load problems (HTTP {(int)response.StatusCode}). {Truncate(body, 120)}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<Result<List<CodingProblemDto>>>();

            if (result?.IsSuccess == true && result.Data != null)
            {
                problems = result.Data
                    .Where(p => p.IsActive)
                    .OrderBy(p => p.Order)
                    .ThenBy(p => p.Title)
                    .ToList();
            }
            else
            {
                errorMessage = result?.Message ?? "Could not load problem bank.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load problems: " + ex.Message;
        }
        finally
        {
            loadingProblems = false;
        }
    }

    private void ToggleProblem(Guid id, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b
                        || (e.Value?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) ?? false);

        if (isChecked)
            selectedIds.Add(id);
        else
            selectedIds.Remove(id);

        StateHasChanged();
    }

    private async Task HandleCreate()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(model.Title))
        {
            errorMessage = "Contest title is required.";
            return;
        }

        if (model.DurationInMinutes < 15)
        {
            errorMessage = "Duration must be at least 15 minutes.";
            return;
        }

        if (selectedIds.Count == 0)
        {
            errorMessage = "Select at least one problem.";
            return;
        }

        isLoading = true;

        model.CodingProblemIds = selectedIds.ToList();

        var offset = tzOffsetMinutes ?? 0;

        model.ContestStartAt = startLocal.HasValue
            ? startLocal.Value.ToUtcFromClientLocal(offset)
            : null;

        model.ContestEndAt = endLocal.HasValue
            ? endLocal.Value.ToUtcFromClientLocal(offset)
            : null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/contests", model);

            // Always read the body as string first so we never explode on empty/non-JSON
            var body = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Failed to create contest (HTTP {(int)response.StatusCode}). {Truncate(body, 200)}";
                return;
            }

            Result<ContestDetailDto>? result = null;
            try
            {
                result = System.Text.Json.JsonSerializer.Deserialize<Result<ContestDetailDto>>(
                    body,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            catch
            {
                errorMessage = "Server returned an unexpected response.";
                return;
            }

            if (result?.IsSuccess == true && result.Data != null)
            {
                successMessage = "Contest created successfully!";
                StateHasChanged();
                await Task.Delay(600);
                Navigation.NavigateTo($"/contests/{result.Data.Id}");
            }
            else
            {
                errorMessage = result?.Message ?? "Failed to create contest.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // ---------- Date helpers (more reliable than @bind on DateTime?) ----------

    private static string FormatForInput(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty;

    private void OnStartChanged(ChangeEventArgs e)
    {
        startLocal = ParseDateTimeLocal(e.Value?.ToString());
    }

    private void OnEndChanged(ChangeEventArgs e)
    {
        endLocal = ParseDateTimeLocal(e.Value?.ToString());
    }

    private static DateTime? ParseDateTimeLocal(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (DateTime.TryParse(value, out var dt))
            return dt;

        return null;
    }

    private static string FormatOffset(int minutes)
    {
        var sign = minutes >= 0 ? "+" : "-";
        var abs = Math.Abs(minutes);
        return $"{sign}{abs / 60}:{abs % 60:D2}";
    }

    private static string Truncate(string? text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        text = text.Trim();
        return text.Length <= max ? text : text[..max] + "...";
    }

    private static string DifficultyBadge(string? d) => d switch
    {
        "Easy" => "bg-success",
        "Medium" => "bg-warning text-dark",
        "Hard" => "bg-danger",
        _ => "bg-secondary"
    };
}