@page "/company/contests"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-0">My Contests</h3>
            <p class="text-muted small mb-0">Coding contests created by your company</p>
        </div>
        <a href="/company/contests/create" class="btn btn-primary btn-sm">+ Create Contest</a>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (loading)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (items.Count == 0)
    {
        <div class="alert alert-info mb-0">
            No contests yet.
            <a href="/company/contests/create">Create your first contest</a>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var c in items)
            {
                <a href="/contests/@c.Id" class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-semibold">@c.Title</div>
                            <div class="small text-muted">
                                @c.ProblemCount problem(s) · @(c.DurationInMinutes ?? 0) min
                                @if (c.ContestStartAt.HasValue)
                                {
                                    <span> · Starts @c.ContestStartAt.Value.ToLocalTime().ToString("g")</span>
                                }
                            </div>
                        </div>
                        <span class="badge @Badge(c.Status)">@c.Status</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Item> items = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var resp = await Http.GetAsync("api/contests/my");
            var raw = await resp.Content.ReadAsStringAsync();

            if (string.IsNullOrWhiteSpace(raw))
            {
                error = $"Empty response (HTTP {(int)resp.StatusCode})";
                return;
            }

            var api = System.Text.Json.JsonSerializer.Deserialize<ApiResult<List<Item>>>(raw,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (api?.IsSuccess == true)
                items = api.Data ?? new();
            else
                error = api?.Message ?? $"Failed (HTTP {(int)resp.StatusCode})";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static string Badge(string s) => s switch
    {
        "Running" => "bg-success",
        "Upcoming" => "bg-primary",
        "Ended" => "bg-secondary",
        "Draft" => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };

    public class Item
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public int? DurationInMinutes { get; set; }
        public DateTime? ContestStartAt { get; set; }
        public DateTime? ContestEndAt { get; set; }
        public int ProblemCount { get; set; }
        public string Status { get; set; } = "";
    }

    public class ApiResult<T>
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public T? Data { get; set; }
    }
}