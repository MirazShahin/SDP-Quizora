@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end gap-3">
            <ThemeToggle />
            <a href="/about" class="top-link">About</a>
        </div>

        <article class="content px-4">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <FriendlyErrorFallback OnRecover="RecoverFromError" />
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <div class="quizora-banner-inner">
        <span class="quizora-banner-icon">📡</span>
        <div class="quizora-banner-text">
            <strong>Connection to the server was lost.</strong>
            <span>Please reload the page to reconnect.</span>
        </div>
        <a href="." class="reload">Reload</a>
        <span class="dismiss" title="Dismiss">🗙</span>
    </div>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    // Lets the "Try again" button in FriendlyErrorFallback reset the boundary
    // and re-render the page instead of leaving the user stuck on the error card.
    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
    }

    protected override void OnParametersSet()
    {
        // Reset the boundary on every navigation so a previous page's error
        // doesn't stick around when the user moves to a different page.
        _errorBoundary?.Recover();
    }
}