@page "/contests/{Id:guid}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Quizora.Application.Common
@using Quizora.Application.DTOs.Contest
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-4">
    @if (loading)
    {
        <p class="text-muted">Loading contest...</p>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
        <a href="/contests" class="btn btn-outline-secondary btn-sm">← Back to Contests</a>
    }
    else if (contest != null)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <a href="/contests" class="text-muted small text-decoration-none">← All Contests</a>
                <h2 class="mt-1 mb-1">@contest.Title</h2>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge @StatusBadge(contest.Status)">@contest.Status</span>
                    <span class="text-muted small">⏱ @(contest.DurationInMinutes ?? 0) minutes</span>
                    @if (contest.ContestStartAt.HasValue)
                    {
                        <span class="text-muted small">
                            · Start: @contest.ContestStartAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </span>
                    }
                    @if (contest.ContestEndAt.HasValue)
                    {
                        <span class="text-muted small">
                            · End: @contest.ContestEndAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </span>
                    }
                    @if (registeredCount > 0)
                    {
                        <span class="text-muted small">· @registeredCount registered</span>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (isRegistered)
                {
                    <span class="badge bg-success fs-6 px-3 py-2">✓ Registered</span>
                }
                else if (registrationOpen)
                {
                    <AuthorizeView Roles="Candidate">
                        <Authorized>
                            <button type="button" class="btn btn-primary" disabled="@regBusy" @onclick="RegisterAsync">
                                @(regBusy ? "Registering…" : "Register for contest")
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn btn-primary">
                                Login to register
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </div>
        </div>

        @* Status banners *@
        @if (contest.Status == "Ended")
        {
            <div class="alert alert-secondary py-2">
                <strong>Contest ended.</strong>
                Problems remain open for practice — new solves do not affect standings.
            </div>
        }
        else if (contest.Status == "Upcoming")
        {
            @if (registrationOpen)
            {
                <div class="alert alert-info py-2">
                    <strong>Registration open.</strong>
                    @if (registrationClosesAt.HasValue)
                    {
                        <span>
                            Closes @registrationClosesAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            (5 minutes before start).
                        </span>
                    }
                    @if (!isRegistered)
                    {
                        <span class="d-block small mt-1">Register to participate when the contest starts.</span>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning py-2">
                    <strong>Registration closed.</strong>
                    Only registered participants can enter when the contest starts.
                </div>
            }
        }
        else if (contest.Status == "Running")
        {
            @if (isRegistered)
            {
                <div class="alert alert-success py-2">
                    <strong>Live contest.</strong> Your submissions count on the standings.
                </div>
            }
            else
            {
                <div class="alert alert-danger py-2">
                    <strong>Not registered.</strong> You cannot submit for rank during this contest.
                    After it ends, you may still practice the problems.
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(regMessage))
        {
            <div class="alert @(regOk ? "alert-success" : "alert-warning") py-2">@regMessage</div>
        }

        @* Tabs *@
        <div class="d-flex gap-2 mb-3">
            <a class="btn btn-sm btn-primary" href="@($"/contests/{Id}")">Problems</a>
            <a class="btn btn-sm btn-outline-primary" href="@($"/contests/{Id}/standings")">Standings</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(contest.Description))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="text-muted mb-2">About</h6>
                    <p class="mb-0" style="white-space: pre-wrap;">@contest.Description</p>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Problems</h5>
                <span class="badge bg-primary">@contest.Problems.Count</span>
            </div>
            <div class="list-group list-group-flush problem-list">
                @if (contest.Problems.Count == 0)
                {
                    <div class="list-group-item text-muted">No problems in this contest.</div>
                }
                else if (contest.Status == "Upcoming")
                {
                    <div class="list-group-item text-muted">
                        Problems unlock when the contest starts.
                        @if (!isRegistered && registrationOpen)
                        {
                            <span>Register above to be eligible.</span>
                        }
                    </div>
                    @* Optional: show titles only, no solve *@
                    @foreach (var p in contest.Problems)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center opacity-75">
                            <div>
                                <span class="fw-bold me-2">@p.Letter.</span>
                                <span>@p.Title</span>
                                <div class="problem-meta mt-1">
                                    <span class="badge @(DifficultyBadge(p.Difficulty))">@p.Difficulty</span>
                                    <span class="ms-2 text-muted small">@p.Points pts</span>
                                </div>
                            </div>
                            <span class="badge bg-secondary">Locked</span>
                        </div>
                    }
                }
                else if (contest.Status == "Running" && !isRegistered)
                {
                    <div class="list-group-item text-muted">
                        You are not registered. Solving is disabled until the contest ends (then practice mode).
                    </div>
                    @foreach (var p in contest.Problems)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center opacity-75">
                            <div>
                                <span class="fw-bold me-2">@p.Letter.</span>
                                <span>@p.Title</span>
                            </div>
                            <span class="badge bg-secondary">Registered only</span>
                        </div>
                    }
                }
                else
                {
                    @* Running + registered, or Ended (practice) *@
                    @foreach (var p in contest.Problems)
                    {
                        <a href="@($"/candidate/coding/solve/{p.CodingProblemId}?contestId={Id}")"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold me-2">@p.Letter.</span>
                                <span class="problem-title">@p.Title</span>
                                <div class="problem-meta mt-1">
                                    <span class="badge @(DifficultyBadge(p.Difficulty))">@p.Difficulty</span>
                                    <span class="ms-2">@p.Points pts · @p.TimeLimitMs ms</span>
                                </div>
                            </div>
                            <span class="text-primary">
                                @(contest.Status == "Ended" ? "Practice →" : "Solve →")
                            </span>
                        </a>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ContestDetailDto? contest;
    private bool loading = true;
    private string? error;

    private bool isRegistered;
    private bool registrationOpen;
    private DateTime? registrationClosesAt;
    private int registeredCount;
    private bool regBusy;
    private string? regMessage;
    private bool regOk;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        regMessage = null;
        try
        {
            var result = await Http.GetFromJsonAsync<Result<ContestDetailDto>>($"api/contests/{Id}");
            if (result?.IsSuccess == true && result.Data != null)
            {
                contest = result.Data;
                ApplyRegistrationFields(result.Data);
            }
            else
                error = result?.Message ?? "Contest not found";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>Reads the real registration fields the API now returns.</summary>
    private void ApplyRegistrationFields(ContestDetailDto c)
    {
        isRegistered = c.IsRegistered;
        registrationOpen = c.RegistrationOpen;
        registrationClosesAt = c.RegistrationClosesAt;
        registeredCount = c.RegisteredCount;
    }

    private async Task RegisterAsync()
    {
        regBusy = true;
        regMessage = null;
        try
        {
            var resp = await Http.PostAsync($"api/contests/{Id}/register", null);
            var raw = await resp.Content.ReadAsStringAsync();
            var api = System.Text.Json.JsonSerializer.Deserialize<Result<object>>(raw,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (api?.IsSuccess == true)
            {
                regOk = true;
                regMessage = api.Message ?? "Registered successfully";
                isRegistered = true;
                await LoadAsync();
            }
            else
            {
                regOk = false;
                regMessage = api?.Message ?? "Registration failed";
            }
        }
        catch (Exception ex)
        {
            regOk = false;
            regMessage = ex.Message;
        }
        finally
        {
            regBusy = false;
        }
    }

    private static string StatusBadge(string status) => status switch
    {
        "Running" => "bg-success",
        "Upcoming" => "bg-primary",
        "Ended" => "bg-secondary",
        "Open" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private static string DifficultyBadge(string? d) => d switch
    {
        "Easy" => "bg-success",
        "Medium" => "bg-warning text-dark",
        "Hard" => "bg-danger",
        _ => "bg-secondary"
    };
}