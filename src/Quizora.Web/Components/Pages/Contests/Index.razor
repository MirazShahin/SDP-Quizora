@page "/contests"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Quizora.Application.Common
@using Quizora.Application.DTOs.Contest
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Coding Contests</h2>
            <p class="text-muted mb-0">Public contests — open for everyone</p>
        </div>
        <AuthorizeView Roles="Company">
            <Authorized>
                <a href="/company/contests/create" class="btn btn-primary">
                    + Create Contest
                </a>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (loading)
    {
        <div class="text-center py-5 text-muted">Loading contests...</div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (contests.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h5 class="text-muted">No public contests yet</h5>
                <p class="text-muted small">Check back later or create one if you are a company.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var c in contests)
            {
                var contestId = c.Id;
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 contest-card" style="cursor:pointer"
                         @onclick="() => GoToContest(contestId)">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@c.Title</h5>
                                <span class="badge @StatusBadge(c.Status)">@c.Status</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(c.Description))
                            {
                                <p class="text-muted small mb-2"
                                   style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                    @c.Description
                                </p>
                            }
                            <div class="d-flex flex-wrap gap-2 small text-muted mt-3">
                                <span>⏱ @(c.DurationInMinutes ?? 0) min</span>
                                <span>·</span>
                                <span>🧩 @c.ProblemCount problems</span>
                                @if (!string.IsNullOrEmpty(c.CompanyName))
                                {
                                    <span>·</span>
                                    <span>🏢 @c.CompanyName</span>
                                }
                            </div>
                            @if (c.ContestStartAt.HasValue)
                            {
                                <div class="small text-muted mt-2">
                                    Start: @c.ContestStartAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ContestListItemDto> contests = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<Result<List<ContestListItemDto>>>("api/contests");
            if (result?.IsSuccess == true && result.Data != null)
                contests = result.Data;
            else
                error = result?.Message ?? "Failed to load contests";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void GoToContest(Guid id)
    {
        Navigation.NavigateTo($"/contests/{id}");
    }

    private static string StatusBadge(string status) => status switch
    {
        "Running" => "bg-success",
        "Upcoming" => "bg-primary",
        "Ended" => "bg-secondary",
        "Open" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}