@page "/interview"
@rendermode InteractiveServer
@inject NavigationManager Nav
@using Quizora.Web.Data

<div class="container py-4">
    <h2 class="fw-bold mb-1">Interview Preparation</h2>
    <p class="text-muted mb-4">Pick a topic · learn from the best free resources</p>

    <div class="row g-3">
        @foreach (var t in InterviewData.All)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm border-0 topic-card"
                     style="cursor:pointer"
                     @onclick="() => Open(t.Slug)">
                    <div class="card-body text-center">
                        <div class="fs-2 mb-2">@t.Icon</div>
                        <h6 class="fw-semibold mb-1">@t.Name</h6>
                        <p class="text-muted small mb-0">@t.Short</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .topic-card {
        transition: transform .15s, box-shadow .15s;
        border-radius: 12px;
    }

        .topic-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,.12) !important;
        }
</style>

@code {
    private void Open(string slug) => Nav.NavigateTo($"/interview/{slug}");
}