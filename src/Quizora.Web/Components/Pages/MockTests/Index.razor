@page "/mock-tests"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Mock Examination</h2>
        <p class="text-muted mb-0">Timed IT assessments · QuizAPI.io · Exam-style environment</p>
    </div>

    <div class="row g-3">
        @foreach (var m in mocks)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 mock-card">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="mock-icon">@m.Icon</div>
                            <span class="badge rounded-pill @m.BadgeClass">@m.Difficulty</span>
                        </div>
                        <h5 class="fw-semibold mb-2">@m.Title</h5>
                        <p class="text-muted small flex-grow-1 mb-3">@m.Description</p>
                        <div class="d-flex flex-wrap gap-2 small text-muted mb-3">
                            <span class="px-2 py-1 rounded bg-light text-dark">📝 @m.Amount Qs</span>
                            <span class="px-2 py-1 rounded bg-light text-dark">⏱ @m.Minutes min</span>
                            <span class="px-2 py-1 rounded bg-light text-dark">📂 @m.Category</span>
                        </div>
                        <button class="btn btn-dark w-100" @onclick="() => Start(m)">
                            Begin Exam →
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .mock-card {
        transition: transform .15s ease, box-shadow .15s ease;
        border-radius: 12px;
    }

        .mock-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
        }

    .mock-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .bg-light {
        background: rgba(255,255,255,.08) !important;
    }
</style>

@code {
    private readonly List<MockPack> mocks = new()
    {
        new("Linux Fundamentals", "🐧", "Linux", "EASY", 10, 15,
            "Commands, filesystem, permissions — foundation check", "bg-success"),
        new("Docker Essentials", "🐳", "Docker", "MEDIUM", 10, 15,
            "Images, containers, Dockerfile patterns", "bg-warning text-dark"),
        new("SQL Challenge", "🗄️", "SQL", "MEDIUM", 12, 20,
            "Queries, joins, indexing concepts", "bg-info text-dark"),
        new("DevOps Assessment", "⚙️", "DevOps", "MEDIUM", 15, 25,
            "CI/CD, infrastructure, cloud basics", "bg-primary"),
        new("Code Concepts", "💻", "Code", "HARD", 15, 25,
            "Algorithms, language fundamentals", "bg-danger"),
        new("Full IT Mock", "🎯", "Programming", "MEDIUM", 20, 30,
            "Mixed programming & systems — full paper", "bg-secondary"),
    };

    private void Start(MockPack m)
    {
        Navigation.NavigateTo(
            $"/mock-tests/take?category={Uri.EscapeDataString(m.Category)}" +
            $"&difficulty={m.Difficulty}&amount={m.Amount}&minutes={m.Minutes}" +
            $"&title={Uri.EscapeDataString(m.Title)}");
    }

    private record MockPack(
        string Title, string Icon, string Category, string Difficulty,
        int Amount, int Minutes, string Description, string BadgeClass);
}