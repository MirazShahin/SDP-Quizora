@page "/practice"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="container mt-4">
    <h2 class="mb-1">IT Practice</h2>
    <p class="text-muted mb-4">Linux · Docker · SQL · DevOps — QuizAPI.io</p>

    <div class="row">
        @foreach (var cat in categories)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="fs-3 mb-2">@cat.Icon</div>
                        <h5 class="card-title">@cat.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@cat.Description</p>
                        <button class="btn btn-primary btn-sm align-self-start"
                                @onclick="() => Start(cat.Name)">
                            Start Practice
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<Cat> categories = new()
    {
        new("Linux",  "🐧", "Linux commands, filesystem, permissions"),
        new("Docker", "🐳", "Containers, images, Docker CLI"),
        new("SQL",    "🗄️", "Queries, joins, database basics"),
        new("DevOps", "⚙️", "CI/CD, cloud, infrastructure"),
        new("Bash",   "💻", "Shell scripting & terminal"),
        new("Code",   "🧑‍💻", "Programming concepts"),
        new("CMS",    "🧩", "WordPress & CMS topics"),
    };

    private void Start(string category)
    {
        Navigation.NavigateTo(
            $"/practice/quiz?category={Uri.EscapeDataString(category)}&difficulty=Easy&amount=10");
    }

    private record Cat(string Name, string Icon, string Description);
}