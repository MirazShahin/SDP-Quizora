<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="quizora-status-page">
                            <div class="quizora-status-icon">🔒</div>
                            <h2>You don't have access to this page</h2>
                            <p>Your account role doesn't allow this section. If you think this is a mistake, contact your administrator.</p>
                            <a class="btn btn-primary" href="/">Back to Dashboard</a>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="quizora-status-page">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3">Checking your session…</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="quizora-status-page">
                    <div class="quizora-status-icon">🧭</div>
                    <h2>Page not found</h2>
                    <p>The page you're looking for doesn't exist or may have moved.</p>
                    <a class="btn btn-primary" href="/">Back to Dashboard</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>